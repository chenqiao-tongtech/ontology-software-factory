{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "tenantId",
    "summary",
    "targetProfile",
    "acceptanceCriteria"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 8,
      "maxLength": 5000
    },
    "targetProfile": {
      "type": "string",
      "enum": [
        "development",
        "production"
      ]
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "overrides": {
      "type": "object",
      "properties": {
        "partitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "replicationFactor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "minInsyncReplicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        }
      },
      "additionalProperties": false
    }
  }
}
