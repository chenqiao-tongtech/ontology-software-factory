{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ontology-software-factory/factory-orchestrator-plan.schema.json",
  "title": "Factory Orchestrator Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "planId", "workflowRunId", "objective", "ontologyBinding", "phases", "limits", "riskAssessment", "humanEscalations", "controlAssertions"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "planId": {"type": "string", "pattern": "^sf:agent-plan:[A-Za-z0-9._-]+$"},
    "workflowRunId": {"type": "string", "minLength": 1, "maxLength": 128},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "ontologyBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "digest", "ontologyId", "ontologyVersion", "schemaVersion"],
      "properties": {
        "snapshotId": {"type": "string", "pattern": "^ont-[a-f0-9]{16}$"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "ontologyId": {"type": "string", "minLength": 1},
        "ontologyVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "schemaVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "phases": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["phaseId", "name", "objective", "dependsOn", "assignments", "acceptanceCriteria"],
        "properties": {
          "phaseId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 200},
          "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
          "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "assignments": {
            "type": "array", "minItems": 1, "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["assignmentId", "roleId", "skillId", "objective", "inputRefs", "outputEntityTypes"],
              "properties": {
                "assignmentId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
                "roleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,70}$"},
                "skillId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,70}$"},
                "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
                "inputRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "maxItems": 50},
                "outputEntityTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "acceptanceCriteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
              }
            }
          },
          "acceptanceCriteria": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        }
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxAgentAssignments", "maxParallelAssignments", "maxRevisionLoops", "maxToolCalls", "timeoutSeconds"],
      "properties": {
        "maxAgentAssignments": {"type": "integer", "minimum": 1, "maximum": 50},
        "maxParallelAssignments": {"type": "integer", "minimum": 1, "maximum": 10},
        "maxRevisionLoops": {"type": "integer", "minimum": 0, "maximum": 5},
        "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 500},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    },
    "riskAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "risks", "requiresHumanApproval"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "risks": {"type": "array", "items": {"type": "string"}},
        "requiresHumanApproval": {"type": "boolean"}
      }
    },
    "humanEscalations": {"type": "array", "items": {"type": "string"}},
    "controlAssertions": {
      "type": "object", "additionalProperties": false,
      "required": ["mayChangeWorkflowState", "mayGrantPermissions", "mayApproveOwnPlan", "mayPublishOntology"],
      "properties": {
        "mayChangeWorkflowState": {"const": false},
        "mayGrantPermissions": {"const": false},
        "mayApproveOwnPlan": {"const": false},
        "mayPublishOntology": {"const": false}
      }
    }
  }
}