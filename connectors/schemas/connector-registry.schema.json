{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "type":"object","required":["schemaVersion","connectors"],
 "properties":{"schemaVersion":{"type":"string"},"connectors":{"type":"array","items":{
  "type":"object","required":["connectorId","name","category","direction","implementationStatus","operations","dataClasses","authMode","credentialRef","networkEgress","approvalRequired","notes"],
  "properties":{
   "connectorId":{"type":"string","pattern":"^(source|action)\\.[a-z0-9-]+$"},
   "name":{"type":"string","minLength":1},"category":{"enum":["ontology-source","agent-action"]},
   "direction":{"enum":["read","write"]},"implementationStatus":{"enum":["implemented","adapter-required","planned"]},
   "operations":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
   "dataClasses":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
   "authMode":{"enum":["none","local-process","local-file","secret-reference","oauth2"]},
   "credentialRef":{"type":["string","null"]},"networkEgress":{"enum":["none","fixed-provider","allowlisted-host"]},
   "approvalRequired":{"type":"boolean"},"notes":{"type":"string"}
  },"additionalProperties":false
 }}},
 "additionalProperties":false
}