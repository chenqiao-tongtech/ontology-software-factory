{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ontology-software-factory/skill-definition.schema.json",
  "title": "Software Factory Skill Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skillId",
    "version",
    "title",
    "description",
    "compatibleRoleIds",
    "inputEntityTypes",
    "outputEntityTypes",
    "requiredToolIds",
    "acceptanceCriteria",
    "failureConditions",
    "contextRequirements",
    "sideEffects",
    "humanReviewRequired"
  ],
  "properties": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "compatibleRoleIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "inputEntityTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Requirement",
          "Product",
          "Component",
          "Version",
          "Artifact",
          "Build",
          "TestRun",
          "Vulnerability",
          "Release",
          "Deployment",
          "Incident",
          "OntologyCandidate",
          "OntologyTermCandidate",
          "OntologyRelationCandidate",
          "OntologyConstraintCandidate",
          "CompetencyQuestion",
          "OntologySourceEvidence",
          "OntologyEvaluation",
          "OntologyApproval",
          "OntologyRevision"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "outputEntityTypes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Requirement",
          "Product",
          "Component",
          "Version",
          "Artifact",
          "Build",
          "TestRun",
          "Vulnerability",
          "Release",
          "Deployment",
          "Incident",
          "OntologyCandidate",
          "OntologyTermCandidate",
          "OntologyRelationCandidate",
          "OntologyConstraintCandidate",
          "CompetencyQuestion",
          "OntologySourceEvidence",
          "OntologyEvaluation",
          "OntologyApproval",
          "OntologyRevision"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredToolIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "failureConditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "contextRequirements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sideEffects": {
      "type": "string",
      "minLength": 1
    },
    "humanReviewRequired": {
      "type": "boolean"
    }
  }
}
