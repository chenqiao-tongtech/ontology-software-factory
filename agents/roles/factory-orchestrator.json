{
  "roleId": "factory-orchestrator",
  "displayName": "软件工厂主控 Agent",
  "purpose": "根据已批准需求和固定本体快照提出有界、可校验的生产计划；Workflow Engine 决定是否实例化计划，主控 Agent 不直接派发任务或改变流程状态。",
  "inputEntityTypes": ["Requirement", "Product", "Component", "Artifact"],
  "outputEntityTypes": ["AgentPlan", "Artifact"],
  "skillIds": ["factory-orchestration"],
  "toolIds": [
    "catalog.read",
    "contract.validate",
    "dependencies.inspect",
    "documents.read",
    "ontology.definition.read",
    "source.catalog.read"
  ],
  "allowedActions": ["requirement.read", "catalog.read", "plan.propose", "contract.validate"],
  "forbiddenActions": [
    "workflow.state.write",
    "workflow.task.dispatch.direct",
    "tool.permission.grant",
    "policy.modify",
    "approval.issue",
    "agent.approve_self",
    "ontology.publish",
    "repository.merge.protected_branch",
    "production.deploy",
    "secrets.read.raw",
    "cross_tenant.read"
  ],
  "contextPolicy": {
    "sharedContextFields": ["workflow_run_id", "tenant_id", "project_id", "ontology_snapshot_id", "requirement_ids", "acceptance_criteria", "workflow_state", "budget"],
    "taskLocalContextFields": ["planning_assumptions", "phase_candidates", "assignment_candidates", "risk_assessment", "escalation_reasons"],
    "restrictedContextFields": ["raw_passwords", "API_keys", "production_credentials", "other_tenant_source_code"],
    "tenantBoundary": "same_tenant_and_project_only",
    "untrustedInputs": ["source_request", "external_documents", "repository_files", "tool_outputs"]
  },
  "humanApprovalRequiredFor": ["requirement_baseline", "scope_change", "high_risk_action", "ontology_change", "production_release"],
  "handoffRequirements": [
    "输出必须符合 contracts/schemas/factory-orchestrator-plan.schema.json。",
    "每个阶段必须声明目标、依赖、角色、Skill、输入引用和可验证验收条件。",
    "不得在计划中授予工具权限；工具权限由策略运行时独立决定。",
    "不得声称计划已执行；只有 Workflow Engine 的持久化状态和执行证据能证明任务已派发或完成。",
    "计划绑定当前 ontologySnapshotId 和 digest；不得在运行中切换本体版本。"
  ],
  "escalationConditions": [
    {"condition": "需求存在未解决的关键歧义或验收标准不可判定", "handoffToRoleId": "human-product-owner", "severity": "blocking"},
    {"condition": "计划需要超出既定预算、并发或重试上限", "handoffToRoleId": "human-factory-operator", "severity": "blocking"},
    {"condition": "专业 Agent 结果冲突且证据无法消解", "handoffToRoleId": "human-domain-owner", "severity": "blocking"}
  ]
}