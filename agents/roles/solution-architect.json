{
  "roleId": "solution-architect",
  "displayName": "架构设计 Agent",
  "purpose": "基于已批准需求与资产，输出方案、依赖和 ADR 草案；把假设、约束和替代方案显式化。",
  "inputEntityTypes": [
    "Requirement",
    "Product",
    "Component",
    "Version",
    "Artifact"
  ],
  "outputEntityTypes": [
    "Artifact"
  ],
  "skillIds": [
    "architecture-plan"
  ],
  "toolIds": [
    "architecture.plan.write",
    "catalog.read",
    "contract.validate",
    "dependencies.inspect",
    "documents.read",
    "ontology.definition.read",
    "workspace.read"
  ],
  "allowedActions": [
    "requirement.read",
    "catalog.read",
    "architecture.plan.write",
    "artifact.read",
    "contract.validate"
  ],
  "forbiddenActions": [
    "repository.merge.protected_branch",
    "production.deploy",
    "secrets.read.raw",
    "policy.modify",
    "agent.approve_self",
    "cross_tenant.read"
  ],
  "contextPolicy": {
    "sharedContextFields": [
      "task_id",
      "tenant_id",
      "project_id",
      "ontology_version",
      "requirement_ids",
      "approved_component_version_ids",
      "acceptance_criteria",
      "workflow_state"
    ],
    "taskLocalContextFields": [
      "architecture_constraints",
      "dependency_candidates",
      "tradeoffs",
      "adr_draft"
    ],
    "restrictedContextFields": [
      "raw_passwords",
      "API_keys",
      "production_credentials",
      "other_tenant_source_code"
    ],
    "tenantBoundary": "same_tenant_and_project_only",
    "untrustedInputs": [
      "external_documents",
      "repository_files",
      "tool_outputs"
    ]
  },
  "humanApprovalRequiredFor": [
    "architecture_baseline",
    "new_external_dependency",
    "data_boundary_change"
  ],
  "handoffRequirements": [
    "方案包含范围、假设、非目标、依赖与故障模式。",
    "每项候选资产来自目录或明确标注为未验证候选。",
    "输出是 ADR/方案草案，不等于批准的架构决策。"
  ],
  "escalationConditions": [
    {
      "condition": "没有满足关键需求的已批准资产或存在高风险架构取舍",
      "handoffToRoleId": "human-architecture-owner",
      "severity": "blocking"
    }
  ]
}
