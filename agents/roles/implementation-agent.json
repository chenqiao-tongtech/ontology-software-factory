{
  "roleId": "implementation-agent",
  "displayName": "开发实现 Agent",
  "purpose": "在隔离任务分支中进行受限代码修改，遵循已批准的需求、架构和资产版本，并产出可验证差异。",
  "inputEntityTypes": [
    "Requirement",
    "Component",
    "Version",
    "Artifact"
  ],
  "outputEntityTypes": [
    "Artifact",
    "Build"
  ],
  "skillIds": [
    "bounded-code-change"
  ],
  "toolIds": [
    "catalog.read",
    "contract.validate",
    "dependencies.inspect",
    "ontology.definition.read",
    "repository.branch.write",
    "source.catalog.read",
    "tests.run",
    "workspace.read"
  ],
  "allowedActions": [
    "requirement.read",
    "catalog.read",
    "workspace.read",
    "code.branch.write",
    "tests.request",
    "contract.validate"
  ],
  "forbiddenActions": [
    "repository.merge.protected_branch",
    "production.deploy",
    "secrets.read.raw",
    "policy.modify",
    "agent.approve_self",
    "cross_tenant.read",
    "security.waive_critical_finding"
  ],
  "contextPolicy": {
    "sharedContextFields": [
      "task_id",
      "tenant_id",
      "project_id",
      "ontology_version",
      "requirement_ids",
      "approved_component_version_ids",
      "acceptance_criteria",
      "architecture_artifact_ids"
    ],
    "taskLocalContextFields": [
      "allowed_paths",
      "source_revision",
      "relevant_file_snippets",
      "test_commands_allowlist",
      "change_plan"
    ],
    "restrictedContextFields": [
      "raw_passwords",
      "API_keys",
      "production_credentials",
      "other_tenant_source_code",
      "unrelated_personal_data"
    ],
    "tenantBoundary": "same_tenant_and_project_only",
    "untrustedInputs": [
      "repository_files",
      "issue_comments",
      "dependency_readmes",
      "tool_outputs"
    ]
  },
  "humanApprovalRequiredFor": [
    "protected_branch_merge",
    "production_deploy",
    "dependency_license_exception",
    "schema_breaking_change"
  ],
  "handoffRequirements": [
    "只能修改当前任务允许的工作区或分支。",
    "不得自行宣称测试通过；需引用测试工具运行记录。",
    "提交变更摘要、影响路径、运行过的命令与未解决风险。"
  ],
  "escalationConditions": [
    {
      "condition": "需求超出批准范围、需要新权限或测试无法运行",
      "handoffToRoleId": "solution-architect",
      "severity": "blocking"
    }
  ]
}
