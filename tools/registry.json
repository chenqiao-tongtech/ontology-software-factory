{
  "version": "1.0.0",
  "tools": [
    {
      "toolId": "catalog.read",
      "description": "读取已批准资产目录中的元数据",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "catalogPath": {
            "type": "string"
          }
        },
        "required": [
          "catalogPath"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "documents.read",
      "description": "读取当前项目中明确允许的文档",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string"
          }
        },
        "required": [
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "contract.validate",
      "description": "校验结构化输入对象",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "payloadJson": {
            "type": "string",
            "maxLength": 100000
          },
          "schemaJson": {
            "type": "string",
            "maxLength": 100000
          }
        },
        "required": [
          "payloadJson",
          "schemaJson"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "workspace.write.candidate",
      "description": "写入隔离运行目录中的候选文件",
      "riskClass": "bounded-write",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "relativePath": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "runId",
          "relativePath",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "tests.run",
      "description": "运行固定的受控校验工作流，不接受自由 Shell 命令",
      "riskClass": "bounded-execution",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "suiteId": {
            "type": "string",
            "enum": [
              "kafka-config-validation",
              "repository-unit-tests"
            ]
          }
        },
        "required": [
          "runId",
          "suiteId"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "release.simulation.promote",
      "description": "在本地模拟环境提升候选交付包；绝不调用外部部署",
      "riskClass": "high-impact",
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "releaseId": {
            "type": "string"
          },
          "targetEnvironment": {
            "type": "string"
          }
        },
        "required": [
          "releaseId",
          "targetEnvironment"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "workspace.read",
      "description": "Read a bounded file from the run-scoped isolated workspace",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string"
          }
        },
        "required": [
          "relativePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "repository.branch.write",
      "description": "Write a candidate file into an isolated run workspace; no Git push or merge",
      "riskClass": "bounded-write",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "relativePath",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "architecture.plan.write",
      "description": "Write an architecture or ADR draft into the isolated workspace",
      "riskClass": "bounded-write",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "relativePath": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "relativePath",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "security.scan",
      "description": "Run one fixed allowlisted scanner and return report evidence",
      "riskClass": "bounded-execution",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "scannerId": {
            "type": "string",
            "enum": [
              "semgrep",
              "gitleaks",
              "trivy"
            ]
          }
        },
        "required": [
          "scannerId"
        ],
        "additionalProperties": false
      }
    },
    {
      "toolId": "ontology.definition.read",
      "description": "读取已批准的本体类与关系元数据",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "conceptName": {
            "type": "string",
            "maxLength": 128
          }
        },
        "additionalProperties": false
      }
    },
    {
      "toolId": "source.catalog.read",
      "description": "读取已登记连接器的能力和实现状态，不发起外部连接",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ontology-source",
              "agent-action"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "toolId": "dependencies.inspect",
      "description": "读取项目声明的 Python 依赖与可选依赖",
      "riskClass": "low",
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ]
}
