  "multi_agent_architecture": {
    "pattern": "bounded_specialist_team_with_deterministic_workflow_control",
    "controller": {
      "component": "workflow-state-machine",
      "llmPowered": false,
      "responsibility": "dispatch, dependency evaluation, join, retry cap, approval gate; never grant IAM permissions"
    },
    "coordination_patterns": [
      "sequential_handoff",
      "parallel_independent_verification",
      "all_required_join",
      "bounded_revision_loop",
      "human_escalation"
    ],
    "parallel_verification_roles": [
      "test-agent",
      "security-reviewer"
    ],
    "max_agent_hops": 16,
    "max_revision_loops": 2,
    "max_parallel_agents": 3,
    "shared_state_authority": [
      "workflow_run_store",
      "event_ledger",
      "versioned_artifact_refs",
      "evidence_refs"
    ],
    "conflict_policy": "Verified tool evidence and approved asset metadata outrank agent assertions; unresolved material conflicts require human review.",
    "approval_policy": "Agent may prepare a candidate but cannot approve its own release or high-risk action.",
