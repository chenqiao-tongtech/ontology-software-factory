{
  "schema_version": "1.0.0",
  "baseline_id": "software-factory-architecture-baseline",
  "baseline_version": "1.1.0",
  "project": {
    "name": "ontology-software-factory",
    "reference_case": "围绕已批准 Kafka 版本进行标准化配置、客户化配置、校验和候选交付；不重写 Kafka。",
    "target": "构建可组合、证据驱动、分阶段可验收的 AI 软件工厂参考实现。",
    "mvp_scope_ref": "config/mvp-scope.json",
    "planning_status": "defined",
    "implementation_status": "partial"
  },
  "principles": [
    {
      "id": "AP-01",
      "name": "资产优先与集成优先",
      "rule": "优先复用批准资产与成熟 Git/CI/测试/扫描/制品平台。"
    },
    {
      "id": "AP-02",
      "name": "共享语义与适配器隔离",
      "rule": "领域对象和契约稳定；厂商差异隔离在 adapters。"
    },
    {
      "id": "AP-03",
      "name": "控制面与执行面分离",
      "rule": "规划/编排只产生授权任务，Runner 按任务规范执行。"
    },
    {
      "id": "AP-04",
      "name": "生成与验证分离",
      "rule": "Agent 产出候选结果，独立工具提供真实验证证据。"
    },
    {
      "id": "AP-05",
      "name": "默认拒绝与最小权限",
      "rule": "未知/未声明/越界工具调用默认拒绝。"
    },
    {
      "id": "AP-06",
      "name": "高风险动作独立审批",
      "rule": "生产部署、删除、迁移、权限和秘密操作需策略及人工闸门。"
    },
    {
      "id": "AP-07",
      "name": "标准资产与客户差异分离",
      "rule": "客户配置和补丁不得静默污染标准版本。"
    },
    {
      "id": "AP-08",
      "name": "证据驱动与可追溯",
      "rule": "结果需关联版本、运行 ID、退出码、日志、报告和制品摘要。"
    },
    {
      "id": "AP-09",
      "name": "可解释失败与可恢复",
      "rule": "提供错误语义、幂等、重试、取消、补偿、回滚和未知结果对账。"
    },
    {
      "id": "AP-10",
      "name": "渐进演进与可替换技术",
      "rule": "模型、Agent 框架和外部工具经稳定接口替换。"
    },
    {
      "id": "AP-11",
      "name": "本体受版本治理",
      "rule": "语义变更需 owner、影响分析、兼容策略、回归测试和批准。"
    },
    {
      "id": "AP-12",
      "name": "用基线评估效果",
      "rule": "以相同任务和质量门槛测量质量、返工、时延、成本和人工介入。"
    },
    {
      "id": "AP-13",
      "name": "多智能体协作显式化与可控",
      "rule": "团队拓扑、角色边界、任务交接、上下文范围、并行汇合、独立验证和修复上限必须显式配置；Workflow 控制派发，Agent 不自行扩权或批准自己的高风险结果。"
    }
  ],
  "constraints": [
    {
      "id": "C-01",
      "name": "产品边界",
      "rule": "Kafka 为示例资产；项目不开发 Kafka 本体。"
    },
    {
      "id": "C-02",
      "name": "生产发布边界",
      "rule": "MVP 不自动部署生产；高风险动作必须经过独立授权和人工确认。"
    },
    {
      "id": "C-03",
      "name": "工具执行边界",
      "rule": "不提供无限制 Shell、任意网络和默认生产凭证。"
    },
    {
      "id": "C-04",
      "name": "证据边界",
      "rule": "模型文字、模拟输出或未绑定版本的报告不视为真实执行证据。"
    },
    {
      "id": "C-05",
      "name": "安全门禁边界",
      "rule": "缺少要求的扫描器/证据时 fail closed。"
    },
    {
      "id": "C-06",
      "name": "本体授权边界",
      "rule": "本体不独立授予权限，实际授权由 IAM/策略组件判定。"
    },
    {
      "id": "C-07",
      "name": "外部集成验收边界",
      "rule": "缺凭据、目标服务或执行环境时标记未验收，不声称通过。"
    },
    {
      "id": "C-08",
      "name": "架构变更边界",
      "rule": "改变范围或安全责任需更新基线、验收项和 ADR。"
    },
    {
      "id": "C-09",
      "name": "多智能体协作边界",
      "rule": "MVP 使用有界专业 Agent 团队与确定性 Workflow 控制器；消息通过版本化 Handoff 契约，权威状态以运行账本/证据引用为准，独立工具和门禁验证候选结果。"
    }
  ],
