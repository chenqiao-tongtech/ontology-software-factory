{
  "id": "software-delivery",
  "name": "软件工厂交付工作流",
  "version": "1.0.0",
  "description": "从需求澄清到受审批约束的部署的七节点工作流演示定义。",
  "startStepId": "requirement-analysis",
  "steps": [
    {
      "id": "requirement-analysis",
      "name": "需求澄清",
      "roleId": "requirement-analyst",
      "skillId": "requirement-normalization",
      "executionMode": "agent",
      "dependsOn": [],
      "timeoutSeconds": 600,
      "maxAttempts": 3,
      "retryableErrorClasses": ["transient_timeout", "worker_lost", "rate_limited"],
      "requiresEvidence": ["normalized-requirement"],
      "requiresIdempotencyKey": true,
      "sideEffect": "none",
      "compensation": null,
      "requiresApproval": false
    },
    {
      "id": "architecture-design",
      "name": "架构设计",
      "roleId": "solution-architect",
      "skillId": "architecture-plan",
      "executionMode": "agent",
      "dependsOn": ["requirement-analysis"],
      "timeoutSeconds": 900,
      "maxAttempts": 3,
      "retryableErrorClasses": ["transient_timeout", "worker_lost", "rate_limited"],
      "requiresEvidence": ["architecture-decision-record", "interface-contract"],
      "requiresIdempotencyKey": true,
      "sideEffect": "none",
      "compensation": null,
      "requiresApproval": false
    },
    {
      "id": "implementation",
      "name": "代码实现",
      "roleId": "implementation-agent",
      "skillId": "bounded-code-change",
      "executionMode": "agent",
      "dependsOn": ["architecture-design"],
      "timeoutSeconds": 3600,
      "maxAttempts": 2,
      "retryableErrorClasses": ["transient_timeout", "worker_lost", "rate_limited"],
      "requiresEvidence": ["commit-reference", "change-summary"],
      "requiresIdempotencyKey": true,
      "sideEffect": "repository-write",
      "compensation": "revert-change-set",
      "requiresApproval": false
    },
    {
      "id": "test-suite",
      "name": "自动化测试",
      "roleId": "test-agent",
      "skillId": "test-evidence-collection",
      "executionMode": "system",
      "dependsOn": ["implementation"],
      "timeoutSeconds": 1800,
      "maxAttempts": 3,
      "retryableErrorClasses": ["transient_timeout", "worker_lost", "rate_limited"],
      "requiresEvidence": ["test-report", "coverage-summary"],
      "requiresIdempotencyKey": true,
      "sideEffect": "none",
      "compensation": null,
      "requiresApproval": false
    },
    {
      "id": "security-review",
      "name": "安全审查",
      "roleId": "security-reviewer",
      "skillId": "dependency-security-review",
      "executionMode": "agent",
      "dependsOn": ["test-suite"],
      "timeoutSeconds": 1200,
      "maxAttempts": 2,
      "retryableErrorClasses": ["transient_timeout", "worker_lost", "rate_limited"],
      "requiresEvidence": ["dependency-scan", "secret-scan", "security-review-summary"],
      "requiresIdempotencyKey": true,
      "sideEffect": "none",
      "compensation": null,
      "requiresApproval": false
    },
    {
      "id": "release-approval",
      "name": "发布审批",
      "roleId": "human-release-approver",
      "skillId": null,
      "executionMode": "human",
      "dependsOn": ["security-review"],
      "timeoutSeconds": 86400,
      "maxAttempts": 1,
      "retryableErrorClasses": [],
      "requiresEvidence": ["test-report", "security-review-summary", "release-manifest"],
      "requiresIdempotencyKey": true,
      "sideEffect": "approval-record",
      "compensation": null,
      "requiresApproval": true
    },
    {
      "id": "deployment",
      "name": "部署",
      "roleId": "release-coordinator",
      "skillId": "release-readiness-check",
      "executionMode": "system",
      "dependsOn": ["release-approval"],
      "timeoutSeconds": 1800,
      "maxAttempts": 2,
      "retryableErrorClasses": ["transient_network_error", "worker_lost", "rate_limited"],
      "requiresEvidence": ["release-manifest", "approval-record", "deployment-result"],
      "requiresIdempotencyKey": true,
      "sideEffect": "external",
      "compensation": "rollback-deployment",
      "requiresApproval": false
    }
  ]
}
