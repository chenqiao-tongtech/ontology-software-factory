{
  "id": "ontology-discovery-review",
  "name": "LLM 辅助本体发现与评审工作流",
  "version": "1.0.0",
  "description": "从授权来源生成本体候选，经多轮结构化发现、独立 Critic、确定性校验、Benchmark 评估和人工审批后，准备版本化变更提案；不直接发布本体。",
  "startStepId": "source-preflight",
  "steps": [
    {"id":"source-preflight","name":"来源授权与脱敏检查","roleId":"ontology-discovery-agent","skillId":null,"executionMode":"system","dependsOn":[],"timeoutSeconds":120,"maxAttempts":1,"retryableErrorClasses":[],"requiresEvidence":["source-manifest","source-hashes","secret-scan-result"],"requiresIdempotencyKey":true,"sideEffect":"none","compensation":null,"requiresApproval":false},
    {"id":"term-discovery","name":"术语候选发现","roleId":"ontology-discovery-agent","skillId":"ontology-discovery","executionMode":"agent","dependsOn":["source-preflight"],"timeoutSeconds":600,"maxAttempts":2,"retryableErrorClasses":["transient_timeout","rate_limited","worker_lost"],"requiresEvidence":["term-candidates","term-source-refs"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-candidate-artifact-only","requiresApproval":false},
    {"id":"relation-discovery","name":"关系与类型发现","roleId":"ontology-discovery-agent","skillId":"ontology-discovery","executionMode":"agent","dependsOn":["term-discovery"],"timeoutSeconds":600,"maxAttempts":2,"retryableErrorClasses":["transient_timeout","rate_limited","worker_lost"],"requiresEvidence":["relation-candidates","relation-endpoint-report"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-candidate-artifact-only","requiresApproval":false},
    {"id":"constraints-and-questions","name":"约束与 Competency Questions","roleId":"ontology-discovery-agent","skillId":"ontology-discovery","executionMode":"agent","dependsOn":["relation-discovery"],"timeoutSeconds":600,"maxAttempts":2,"retryableErrorClasses":["transient_timeout","rate_limited","worker_lost"],"requiresEvidence":["constraint-candidates","competency-questions"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-candidate-artifact-only","requiresApproval":false},
    {"id":"independent-critic","name":"独立语义审查","roleId":"ontology-critic-agent","skillId":"ontology-critic-review","executionMode":"agent","dependsOn":["constraints-and-questions"],"timeoutSeconds":600,"maxAttempts":2,"retryableErrorClasses":["transient_timeout","rate_limited","worker_lost"],"requiresEvidence":["critic-findings","candidate-digest"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-critic-artifact-only","requiresApproval":false},
    {"id":"deterministic-validation","name":"Schema、引用和语义校验","roleId":"ontology-discovery-agent","skillId":null,"executionMode":"system","dependsOn":["independent-critic"],"timeoutSeconds":120,"maxAttempts":1,"retryableErrorClasses":[],"requiresEvidence":["schema-validation","provenance-validation","semantic-validation"],"requiresIdempotencyKey":true,"sideEffect":"none","compensation":null,"requiresApproval":false},
    {"id":"benchmark-evaluation","name":"Benchmark 评估","roleId":"ontology-critic-agent","skillId":null,"executionMode":"system","dependsOn":["deterministic-validation"],"timeoutSeconds":300,"maxAttempts":1,"retryableErrorClasses":[],"requiresEvidence":["term-metrics","relation-metrics","provenance-coverage"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-evaluation-report-only","requiresApproval":false},
    {"id":"human-domain-review","name":"领域专家审批","roleId":"human-domain-owner","skillId":null,"executionMode":"human","dependsOn":["benchmark-evaluation"],"timeoutSeconds":86400,"maxAttempts":1,"retryableErrorClasses":[],"requiresEvidence":["reviewer-id","approval-ref","approved-candidate-digest"],"requiresIdempotencyKey":true,"sideEffect":"approval-record","compensation":null,"requiresApproval":true},
    {"id":"versioned-change-proposal","name":"生成版本化变更提案","roleId":"ontology-discovery-agent","skillId":null,"executionMode":"system","dependsOn":["human-domain-review"],"timeoutSeconds":300,"maxAttempts":1,"retryableErrorClasses":[],"requiresEvidence":["ontology-diff","migration-plan","regression-test-plan"],"requiresIdempotencyKey":true,"sideEffect":"artifact-write","compensation":"delete-proposal-artifact-only","requiresApproval":false}
  ]
}
