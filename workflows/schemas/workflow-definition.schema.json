{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/workflow-definition.schema.json",
  "title": "Workflow Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "startStepId",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string"
    },
    "startStepId": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "roleId",
          "executionMode",
          "dependsOn",
          "timeoutSeconds",
          "maxAttempts",
          "retryableErrorClasses",
          "requiresEvidence",
          "requiresIdempotencyKey",
          "sideEffect",
          "requiresApproval"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "roleId": {
            "type": "string",
            "minLength": 1
          },
          "skillId": {
            "type": [
              "string",
              "null"
            ]
          },
          "executionMode": {
            "enum": [
              "agent",
              "system",
              "human"
            ]
          },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "retryableErrorClasses": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "requiresEvidence": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "requiresIdempotencyKey": {
            "type": "boolean"
          },
          "sideEffect": {
            "enum": [
              "none",
              "repository-write",
              "approval-record",
              "external",
              "artifact-write"
            ]
          },
          "compensation": {
            "type": [
              "string",
              "null"
            ]
          },
          "requiresApproval": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
