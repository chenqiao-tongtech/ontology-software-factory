{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ontology-software-factory/module-manifest.schema.json",
  "title": "Ontology Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "ontologyId", "ontologyVersion", "canonicalSource", "authority", "modules"],
  "properties": {
    "manifestVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ontologyId": {"type": "string", "minLength": 1},
    "ontologyVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "canonicalSource": {"const": "ontology/software-factory-ontology.json"},
    "authority": {"const": "canonical-source"},
    "modules": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["moduleId", "version", "description", "classes", "relations"],
        "properties": {
          "moduleId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "description": {"type": "string", "minLength": 1},
          "classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "relations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}